---
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="zh-CN">
  <title>{{ site.title_zh | xml_escape }}</title>
  <subtitle>{{ site.description | strip_newlines | xml_escape }}</subtitle>
  <id>{{ site.base_url }}/feed.xml</id>
  <link rel="self" type="application/atom+xml" href="{{ site.base_url }}/feed.xml"/>
  <link rel="alternate" type="text/html" href="{{ site.base_url }}/blog/"/>
  <updated>{% if site.posts.size > 0 %}{{ site.posts.first.date | date_to_xmlschema }}{% else %}2026-10-17T00:00:00Z{% endif %}</updated>
  <author><name>班奈特格林 (Bennet Green)</name><uri>{{ site.base_url }}/</uri></author>
{% for post in site.posts limit:20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link rel="alternate" type="text/html" href="{{ site.base_url }}{{ post.url }}"/>
    <id>{{ site.base_url }}{{ post.url }}</id>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <summary type="text">{{ post.excerpt | strip_html | normalize_whitespace | xml_escape }}</summary>
  </entry>
{% endfor %}
</feed>
